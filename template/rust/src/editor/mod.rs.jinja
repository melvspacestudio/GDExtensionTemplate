use godot::classes::{EditorPlugin, IEditorPlugin};
use godot::prelude::*;

/// Editor-only entry point for docks, gizmos, and inspector plugins.
#[derive(GodotClass)]
#[class(tool, base = EditorPlugin)]
struct [[[ class_prefix ]]]EditorPlugin {
    base: Base<EditorPlugin>,
}

#[godot_api]
impl IEditorPlugin for [[[ class_prefix ]]]EditorPlugin {
    fn init(base: Base<EditorPlugin>) -> Self {
        Self { base }
    }
}
